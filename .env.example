# Address Book API — environment configuration
# Copy this file to `.env` and adjust values as needed.
# Every variable is optional; unset values fall back to the defaults
# of the selected environment (see source/app/config.py).

# Active environment: dev | test | prod
ENVIRONMENT=dev

# SQLite connection string. Examples:
#   dev:  sqlite:////tmp/addresses.db
#   prod: sqlite:////data/addresses.db
DATABASE_URL=sqlite:////tmp/addresses.db

# Path of the rotating JSON log file.
APP_LOG_FILE=/tmp/app-logs/app.log

# Log level for the application loggers (INFO, WARNING, ...).
LOG_LEVEL=INFO